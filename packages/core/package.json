{
  "name": "@repodeck/core",
  "version": "0.6.0",
  "description": "Framework-free core for repodeck: fetch, parse, and build GitHub repo card data. Zero DOM, zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "repodeck",
  "repository": {
    "type": "git",
    "url": "https://github.com/leibHz/repodeck.git"
  },
  "bugs": {
    "url": "https://github.com/leibHz/repodeck/issues"
  },
  "keywords": [
    "repodeck",
    "github",
    "card",
    "embed",
    "headless",
    "ssr",
    "ssg",
    "framework-free"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "marked": "^18.0.0",
    "isomorphic-dompurify": "^3.18.0"
  },
  "tsup": {
    "entry": ["src/index.ts"],
    "format": ["esm", "cjs"],
    "dts": true,
    "splitting": false,
    "sourcemap": false,
    "clean": true,
    "treeshake": false,
    "concurrency": 1,
    "external": ["marked", "isomorphic-dompurify"]
  }
}
